[Unit]
Description=islandr-proxy — executes the wg/nft allowlist for the islandr container
Documentation=https://github.com/chriscohnen/islandr/blob/main/docs/adr/0012-docker-socket-proxy.md
Requires=islandr-proxy.socket
After=islandr-proxy.socket

[Service]
Type=simple
User=islandr
Group=islandr
ExecStart=/usr/local/bin/islandr-proxy

# The listening socket is handed in by systemd (LISTEN_FDS); the process never
# opens one itself. sudo must be able to escalate, so NoNewPrivileges stays off.
NoNewPrivileges=false

# Light hardening that does not interfere with sudo wg/nft:
# ProtectHome=true hides /home entirely (empty tmpfs), which breaks setups
# where /var/lib/islandr or the socket dir is a symlink/bind pointing under
# a user's home (e.g. to work around snap Docker's confined mount namespace,
# which can only bind-mount paths under $HOME). read-only keeps the proxy
# from writing into /home while still letting such symlinks resolve.
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true
# Short-lived preshared-key files go to /etc/wireguard/islandr — on Ubuntu 26.04
# the only place wg may read a key from (AppArmor). ProtectSystem=full makes
# /etc read-only, so it is opened up here; the leading '-' keeps the unit
# starting where the directory does not exist, and the proxy then falls back
# to /run/islandr (tmpfiles, islandr:islandr 0700), which earlier releases
# used. runtimeDir() falls back to /run/islandr when RUNTIME_DIRECTORY is
# unset, so no RuntimeDirectory= is declared here.
ReadWritePaths=-/etc/wireguard/islandr

[Install]
WantedBy=multi-user.target
